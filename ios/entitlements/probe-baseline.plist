<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      A false debug entitlement keeps the dictionary non-empty without granting
      authority. TrollStore 2.1.1 therefore preserves this profile instead of
      injecting its get-task-allow=true fallback and requesting Developer Mode.
    -->
    <key>get-task-allow</key>
    <false/>
</dict>
</plist>
